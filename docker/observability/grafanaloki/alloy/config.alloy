// 1. Alloy Internal Logging
// Keeps track of the pipeline's own health
logging {
  level  = "info"
  format = "logfmt"
}

// ==========================================
// 2. EXPORTERS (Destinations)
// ==========================================

// Forwarding logs to the local Loki container on the observability network
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Forwarding metrics to the local Prometheus container
prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ==========================================
// 3. RECEIVERS (OPNsense Telemetry)
// ==========================================

loki.source.syslog "opnsense_syslog" {
  listener {
    address  = "0.0.0.0:5140"
    protocol = "udp"
  }
  // Back to the stable forwarder
  forward_to = [loki.process.opnsense_labels.receiver]
}

loki.process "opnsense_labels" {

  // 1. Tag everything with the baseline job first so we can filter on it
  stage.static_labels {
    values = {
      job      = "opnsense_telemetry",
      instance = "lenovo-m920q",
    }
  }

  // 2. Drop the B.A.T.M.A.N. noise
  stage.drop {
    expression = "arp: 43:05:43:05.*is multicast"
  }

  // 3. Isolate and Parse Unbound Logs
  // We use LogQL to select lines starting with [Numbers:Numbers]
  stage.match {
    selector = "{job=\"opnsense_telemetry\"} |~ \"^\\\\[\\\\d+:\\\\d+\\\\]\""

    // If it matches the brackets, we know it's Unbound. Inject the label back in!
    stage.static_labels {
      values = {
        program = "unbound",
      }
    }
    stage.regex {
      expression = "(?P<dns_action>\\S+): (?P<dns_client_ip>[\\d.]+) (?P<dns_domain>\\S+) (?P<dns_query_type>\\S+) (?P<dns_rcode>\\S+)"
    }

    // Promote the extracted groups to indexed Loki labels
    stage.labels {
      values = {
        action     = "dns_action",
        client_ip  = "dns_client_ip",
        query_type = "dns_query_type",
        domain     = "dns_domain",
        rcode      = "dns_rcode",
      }
    }
  }

  forward_to = [loki.write.local_loki.receiver]
}
// ==========================================
// 4. RECEIVERS (Suricata IDS Telemetry)
// ==========================================

loki.source.syslog "suricata_syslog" {
  listener {
    address  = "0.0.0.0:5141"
    protocol = "udp"
  }
  // Suricata sends JSON, not RFC5424, so no syslog_format flag here!
  forward_to = [loki.process.suricata_parser.receiver]
}

loki.process "suricata_parser" {

  // 1. Fix the snippet's broken hostname logic + add your baseline tags
  stage.static_labels {
    values = {
      job      = "suricata_ids",
      instance = "lenovo-m920q",
      hostname = "OPNsense",
    }
  }

  // 2. Harvest the JSON extraction logic
  stage.json {
    expressions = {
      srcip          = "src_ip",
      dstip          = "dest_ip",
      alert_severity = "alert.severity",
      alert_category = "alert.category",
    }
  }

  // 3. Promote the critical security data to indexable labels
  stage.labels {
    values = {
      severity = "alert_severity",
      category = "alert_category",
    }
  }

// ==========================================
// GEO-IP ENRICHMENT
// ==========================================
   stage.geoip {
     source  = "srcip"
     db      = "/etc/alloy/GeoLite2-City.mmdb"
     db_type = "city"
   }
   stage.labels {
     values = {
       src_city_name          = "geoip_city_name",
       src_country_name       = "geoip_country_name",
       src_location_latitude  = "geoip_location_latitude",
       src_location_longitude = "geoip_location_longitude",
     }
   }
   stage.geoip {
     source  = "dstip"
     db      = "/etc/alloy/GeoLite2-City.mmdb"
     db_type = "city"
   }
   stage.labels {
     values = {
       dst_city_name          = "geoip_city_name",
       dst_country_name       = "geoip_country_name",
       dst_location_latitude  = "geoip_location_latitude",
       dst_location_longitude = "geoip_location_longitude",
     }
   }

// 4. Ship it to the database
forward_to = [loki.write.local_loki.receiver]
}

// ==========================================
// 5. BASIC HOST METRICS
// ==========================================

// By bind mounting /proc and /sys in docker-compose.yml,
// we can scrape our host's hardware metrics.
prometheus.exporter.unix "host_system" {
  procfs_path = "/proc"
  sysfs_path  = "/sys"
}

// Scrape the unix exporter and forward to Prometheus
prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host_system.targets
  forward_to = [prometheus.remote_write.local_prometheus.receiver]
}
// ==========================================
// 6. DOCKER METRICS
// ==========================================

// Discover all running Docker containers
discovery.docker "local_containers" {
  host = "tcp://dockerproxy:2375"
  // (Note: use your tcp:// proxy address here if you chose Option 2 earlier)
}

// Intercept the targets and rename the labels before passing them on
discovery.relabel "container_names" {
  targets = discovery.docker.local_containers.targets

  // Rule 1: Extract the container name and strip the leading slash
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  // Rule 2 Grab the compose service name too
  rule {
    source_labels = ["__meta_docker_network_compose_service"]
    target_label  = "compose_service"
  }
}

// ==========================================
// 7. DOCKER LOGS
// ==========================================

loki.source.docker "docker_logs" {
  host       = "tcp://dockerproxy:2375"
  targets    = discovery.relabel.container_names.output

  // 1. Route to the parser instead of the database
  forward_to = [loki.process.nginx_router.receiver]
}

// ==========================================
// 8. NGINX LOGS
// ==========================================

loki.process "nginx_router" {
  forward_to = [loki.write.local_loki.receiver]

  // 2. Only run this heavy processing on your specific web container
  stage.match {
    selector = "{container_name=\"tobondev\"}"

    stage.json {
      expressions = {
        client_ip         = "client_ip",
        status            = "status",
        req_method        = "request_method",
        req_time          = "request_time",
        request_uri       = "request_uri",
        http_referrer     = "http_referrer",
        http_user_agent   = "http_user_agent",
        body_bytes_sent   = "body_bytes_sent",
        x_forwarded_for   = "x_forwarded_for",
      }
    }

    stage.regex {
      source     = "x_forwarded_for"
      expression = "^(?P<real_ip>[^, ]+)"
    }

    // 3. Explicitly check that real_ip is not a hyphen
    stage.template {
      source   = "real_ip"
      template = "{{ if and .real_ip (ne .real_ip \"-\") }}{{ .real_ip }}{{ else }}{{ .client_ip }}{{ end }}"
    }

    stage.geoip {
      source  = "real_ip"
      db      = "/etc/alloy/GeoLite2-City.mmdb"
      db_type = "city"
    }

    stage.regex {
      source     = "request_uri"
      expression = ".*[?&]utm_source=(?P<utm_source>[^&]+).*"
    }
    stage.regex {
      source     = "request_uri"
      expression = ".*[?&]utm_medium=(?P<utm_medium>[^&]+).*"
    }
    stage.regex {
      source     = "request_uri"
      expression = ".*[?&]utm_campaign=(?P<utm_campaign>[^&]+).*"
    }

    stage.static_labels {
      values = {
        traffic_type = "human",
      }
    }

    stage.labels {
      values = {
        status          = "status",
        geo_country     = "geoip_country_name",
        geo_city        = "geoip_city_name",
        geo_latitude    = "geoip_location_latitude",
        geo_longitude   = "geoip_location_longitude",
        utm_source      = "utm_source",
        utm_medium      = "utm_medium",
        utm_campaign    = "utm_campaign",
        http_referrer   = "http_referrer",
        http_user_agent = "http_user_agent",
        request_uri     = "request_uri",
        remote_user     = "remote_user",
        request         = "request",
      }
    }

    // 4. Removed stage.output to preserve the JSON payload
  }
}
